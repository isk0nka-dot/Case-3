# =============================================================================
# argus-frontend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Backend API base URL (argus-backend service)
# Local dev: http://localhost:8080
# Production: https://api.argus.ai
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Nuxt devtools (disable in CI)
NUXT_DEVTOOLS_ENABLED=true
