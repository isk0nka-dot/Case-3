# =============================================================================
# argus-backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
EVENT_COLLECTOR_GRPC_PORT=50051
EVENT_COLLECTOR_HTTP_PORT=8080

# ── JWT (REQUIRED in production) ─────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -hex 32
EVENT_COLLECTOR_JWT_SIGNING_KEY=change-me-min-32-chars-for-hmac-sha256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example (production): https://app.argus.ai,https://staging.argus.ai
# Local dev: http://localhost:3000
EVENT_COLLECTOR_CORS_ORIGINS=http://localhost:3000

# ── Kafka ─────────────────────────────────────────────────────────────────────
EVENT_COLLECTOR_KAFKA_BROKERS=localhost:9092

# ── ClickHouse ────────────────────────────────────────────────────────────────
EVENT_COLLECTOR_CH_ADDRS=localhost:9000
EVENT_COLLECTOR_CH_DATABASE=argus_analytics
EVENT_COLLECTOR_CH_USERNAME=default
EVENT_COLLECTOR_CH_PASSWORD=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
EVENT_COLLECTOR_PG_HOST=localhost
EVENT_COLLECTOR_PG_PORT=5432
EVENT_COLLECTOR_PG_DATABASE=argus
EVENT_COLLECTOR_PG_USERNAME=argus
EVENT_COLLECTOR_PG_PASSWORD=argus_secret
EVENT_COLLECTOR_PG_SSL_MODE=disable

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
EVENT_COLLECTOR_MINIO_ENDPOINT=localhost:9002
EVENT_COLLECTOR_MINIO_ACCESS_KEY=argus-minio-admin
EVENT_COLLECTOR_MINIO_SECRET_KEY=change-me-in-production
EVENT_COLLECTOR_MINIO_BUCKET=argus-evidence
EVENT_COLLECTOR_MINIO_USE_SSL=false

# ── LiveKit (WebRTC) ─────────────────────────────────────────────────────────
LIVEKIT_API_KEY=argus-dev-api-key
LIVEKIT_API_SECRET=change-me-must-be-at-least-32-characters-long
LIVEKIT_WS_URL=ws://localhost:7880

# ── Telegram Alerting ─────────────────────────────────────────────────────────
# Bot token falls back to hardcoded default if unset. Chat ID is REQUIRED for alerts.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=936508677

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
EVENT_COLLECTOR_LOG_LEVEL=info
