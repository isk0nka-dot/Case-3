# =============================================================================
# argus-infra — Environment Variables
# Copy to .env and fill in all required values.
# =============================================================================

# ── Image versions ─────────────────────────────────────────────────────────────
BACKEND_TAG=latest
FRONTEND_TAG=latest

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_GRPC_PORT=50051
BACKEND_HTTP_PORT=8080
FRONTEND_PORT=3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL that the BROWSER uses to reach the backend API.
# In production this is typically your API gateway/load balancer URL.
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000

# ── JWT (REQUIRED — min 32 chars) ────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SIGNING_KEY=change-me-min-32-chars-for-hmac-sha256-CHANGE-IN-PRODUCTION

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me-in-production

# ── ClickHouse ────────────────────────────────────────────────────────────────
CH_DATABASE=argus_analytics
CH_USERNAME=default
CH_PASSWORD=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=argus-minio-admin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=argus-evidence

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=argus-dev-api-key
LIVEKIT_API_SECRET=change-me-must-be-at-least-32-characters-long

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
