# =============================================================================
# argus-backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
ARGUS_PROJECT_ROOT=/opt/argus-ai
ARGUS_BACKEND_HTTP_PORT=8080
ARGUS_INFERENCE_GRPC_PORT=50061
ARGUS_CLICKHOUSE_HTTP_PORT=8123
ARGUS_CLICKHOUSE_NATIVE_PORT=9000
DOCKER_GROUP_ID=110
EVENT_COLLECTOR_GRPC_PORT=50051
EVENT_COLLECTOR_HTTP_PORT=8080

# Public browser SDK URL returned by External API create-session responses.
# Production example: https://cdn.argusai.kz/sdk/v1/argus-sdk.umd.js
ARGUS_SDK_URL=http://localhost:3000/sdk/argus-sdk.umd.js

# ── JWT (REQUIRED in production) ─────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -hex 32
EVENT_COLLECTOR_JWT_SIGNING_KEY=change-me-min-32-chars-for-hmac-sha256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example (production): https://app.argus.ai,https://staging.argus.ai
# Local dev: http://localhost:3000
EVENT_COLLECTOR_CORS_ORIGINS=http://localhost:3000

# ── Kafka ─────────────────────────────────────────────────────────────────────
EVENT_COLLECTOR_KAFKA_BROKERS=localhost:9092

# ── ClickHouse ────────────────────────────────────────────────────────────────
ARGUS_CLICKHOUSE_DATABASE=argus_analytics
ARGUS_CLICKHOUSE_USER=default
ARGUS_CLICKHOUSE_PASSWORD=change-me-in-production
EVENT_COLLECTOR_CH_ADDRS=localhost:9000
EVENT_COLLECTOR_CH_DATABASE=argus_analytics
EVENT_COLLECTOR_CH_USERNAME=default
EVENT_COLLECTOR_CH_PASSWORD=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
ARGUS_POSTGRES_DB=argus_db
ARGUS_POSTGRES_USER=argus
ARGUS_POSTGRES_PASSWORD=change-me-in-production
EVENT_COLLECTOR_PG_HOST=localhost
EVENT_COLLECTOR_PG_PORT=5432
EVENT_COLLECTOR_PG_DATABASE=argus
EVENT_COLLECTOR_PG_USERNAME=argus
EVENT_COLLECTOR_PG_PASSWORD=argus_secret
EVENT_COLLECTOR_PG_SSL_MODE=disable

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
ARGUS_MINIO_ROOT_USER=argus-minio-admin
ARGUS_MINIO_ROOT_PASSWORD=change-me-in-production
ARGUS_MINIO_BUCKET=argus-evidence
ARGUS_MINIO_EXPORT_BUCKET=argus-exports
EVENT_COLLECTOR_MINIO_ENDPOINT=localhost:9002
EVENT_COLLECTOR_MINIO_ACCESS_KEY=argus-minio-admin
EVENT_COLLECTOR_MINIO_SECRET_KEY=change-me-in-production
EVENT_COLLECTOR_MINIO_BUCKET=argus-evidence
EVENT_COLLECTOR_MINIO_USE_SSL=false

# ── LiveKit (WebRTC) ─────────────────────────────────────────────────────────
LIVEKIT_API_KEY=argus-dev-api-key
LIVEKIT_API_SECRET=change-me-must-be-at-least-32-characters-long
LIVEKIT_WS_URL=ws://localhost:7880

# ── Telegram Alerting ─────────────────────────────────────────────────────────
# Bot token falls back to hardcoded default if unset. Chat ID is REQUIRED for alerts.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=936508677

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
EVENT_COLLECTOR_LOG_LEVEL=info

# ── Backend AI Inference ─────────────────────────────────────────────────────
# Production uses the Python ONNX sidecar. Keep allow_stub=false outside local dev.
EVENT_COLLECTOR_INFERENCE_ENGINE_TYPE=python_bridge
EVENT_COLLECTOR_INFERENCE_ALLOW_STUB=false
EVENT_COLLECTOR_INFERENCE_PYTHON_BRIDGE_URL=http://localhost:8091
EVENT_COLLECTOR_INFERENCE_BRIDGE_TIMEOUT_SEC=5
EVENT_COLLECTOR_INFERENCE_CONCURRENCY=2
EVENT_COLLECTOR_INFERENCE_FRAME_SAMPLE_INTERVAL_SEC=4
EVENT_COLLECTOR_INFERENCE_FACE_MISMATCH_THRESHOLD=0.62
EVENT_COLLECTOR_INFERENCE_OBJECT_CONFIDENCE_THRESHOLD=0.35

# Python sidecar model settings.
ONNX_MODELS_PATH=./models
YOLO_MODEL_FILE=yolov8n.onnx
ARCFACE_MODEL_FILE=arcface.onnx
MODEL_FAIL_FAST=true
YOLO_CONFIDENCE_THRESHOLD=0.35
FACE_MISMATCH_THRESHOLD=0.62
AUDIO_VAD_THRESHOLD=0.65
FRAME_EXTRACTION_INTERVAL_SEC=4
