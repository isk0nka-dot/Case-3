# =============================================================================
# Argus + Webizon Hardened Single-Node Production Environment
# Copy to /opt/argus-ai/argus-infra/docker/.env on the server.
# Never commit the real .env file.
# =============================================================================

# Public domains
ARGUS_PUBLIC_URL=https://argusai.kz
ARGUS_CORS_ORIGINS=https://argusai.kz,https://www.argusai.kz
WEBIZON_PUBLIC_URL=https://webizon.kz
CERTBOT_EMAIL=admin@argusai.kz

# GitLab Container Registry images
ARGUS_FRONTEND_IMAGE=registry.gitlab.com/argus_ai_group/argus-frontend:latest
ARGUS_BACKEND_IMAGE=registry.gitlab.com/argus_ai_group/argus-backend:latest
ARGUS_WORKER_IMAGE=registry.gitlab.com/argus_ai_group/argus-backend/worker:latest
ARGUS_INFERENCE_IMAGE=registry.gitlab.com/argus_ai_group/argus-backend/inference:latest
ARGUS_AI_SIDECAR_IMAGE=registry.gitlab.com/argus_ai_group/argus-backend/ai-sidecar:latest
WEBIZON_APP_IMAGE=registry.gitlab.com/argus_ai_group/webizon:latest

# Argus secrets
ARGUS_JWT_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
ARGUS_POSTGRES_DB=argus_db
ARGUS_POSTGRES_USER=argus
ARGUS_POSTGRES_PASSWORD=change-me
ARGUS_CLICKHOUSE_DATABASE=argus_analytics
ARGUS_CLICKHOUSE_USER=default
ARGUS_CLICKHOUSE_PASSWORD=change-me
ARGUS_MINIO_ROOT_USER=argus-minio-admin
ARGUS_MINIO_ROOT_PASSWORD=change-me
ARGUS_MINIO_BUCKET=argus-evidence
ARGUS_MINIO_EXPORT_BUCKET=argus-exports

# Argus AI models
ARGUS_MODELS_PATH=/opt/argus-ai/argus-backend/models
ARGUS_YOLO_MODEL_FILE=yolov8n.onnx
ARGUS_ARCFACE_MODEL_FILE=arcface.onnx
ARGUS_YOLO_CONFIDENCE_THRESHOLD=0.35
ARGUS_FACE_MISMATCH_THRESHOLD=0.62
ARGUS_AUDIO_VAD_THRESHOLD=0.65
ARGUS_FRAME_EXTRACTION_INTERVAL_SEC=4
ARGUS_LOG_LEVEL=info

# Webizon
WEBIZON_POSTGRES_DB=webizon
WEBIZON_POSTGRES_USER=webizon
WEBIZON_POSTGRES_PASSWORD=change-me
